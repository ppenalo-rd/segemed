                        <h6 class="text-secondary fw-bold mb-3">Razonamiento Clínico y Codificación CIE-10</h6>
                        <div class="mb-3">
                            <label class="form-label fw-bold" for="labResultsSummary">Resultados de laboratorio y paraclínicos considerados</label>
                            <textarea class="form-control" id="labResultsSummary" name="lab_results_summary" rows="3" placeholder="Resumen de resultados revisados para el análisis clínico..."></textarea>
                        </div>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-bold mb-0">(A) Análisis / Juicio Clínico:</label>
                            </div>
                            <textarea class="form-control" id="assessment_text" name="assessment" rows="3" placeholder="Razonamiento clínico y diagnósticos presuntivos..."></textarea>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label fw-bold" for="cie10Primary">(A) Diagnóstico principal CIE-10:</label>
                                <div class="cie10-autocomplete position-relative">
                                    <input type="hidden" id="cie10PrimaryCanonical" name="cie10_primary_code"
                                           class="cie10-canonical-code" data-canonical-name="cie10_primary_code">
                                    <input type="hidden" class="cie10-canonical-description">
                                    <input type="search" class="form-control cie10-code" id="cie10Primary"
                                           data-canonical-name="cie10_primary_code"
                                           autocomplete="off" placeholder="Buscar por código o término"
                                           role="combobox" aria-autocomplete="list" aria-haspopup="listbox" aria-expanded="false"
                                           aria-controls="cie10PrimaryOptions">
                                    <div class="list-group cie10-suggestions position-absolute top-100 start-0 w-100 shadow d-none"
                                         id="cie10PrimaryOptions" role="listbox"></div>
                                    <small class="form-text cie10-selection" aria-live="polite"></small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold" for="cie10Secondary">Diagnóstico secundario CIE-10:</label>
                                <div class="cie10-autocomplete position-relative">
                                    <input type="hidden" id="cie10SecondaryCanonical" name="cie10_secondary_code"
                                           class="cie10-canonical-code" data-canonical-name="cie10_secondary_code">
                                    <input type="hidden" class="cie10-canonical-description">
                                    <input type="search" class="form-control cie10-code" id="cie10Secondary"
                                           data-canonical-name="cie10_secondary_code"
                                           autocomplete="off" placeholder="Buscar por código o término"
                                           role="combobox" aria-autocomplete="list" aria-haspopup="listbox" aria-expanded="false"
                                           aria-controls="cie10SecondaryOptions">
                                    <div class="list-group cie10-suggestions position-absolute top-100 start-0 w-100 shadow d-none"
                                         id="cie10SecondaryOptions" role="listbox"></div>
                                    <small class="form-text cie10-selection" aria-live="polite"></small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold" for="cie10Tertiary">Diagnóstico tercero CIE-10:</label>
                                <div class="cie10-autocomplete position-relative">
                                    <input type="hidden" id="cie10TertiaryCanonical" name="cie10_tertiary_code"
                                           class="cie10-canonical-code" data-canonical-name="cie10_tertiary_code">
                                    <input type="hidden" class="cie10-canonical-description">
                                    <input type="search" class="form-control cie10-code" id="cie10Tertiary"
                                           data-canonical-name="cie10_tertiary_code"
                                           autocomplete="off" placeholder="Buscar por código o término"
                                           role="combobox" aria-autocomplete="list" aria-haspopup="listbox" aria-expanded="false"
                                           aria-controls="cie10TertiaryOptions">
                                    <div class="list-group cie10-suggestions position-absolute top-100 start-0 w-100 shadow d-none"
                                         id="cie10TertiaryOptions" role="listbox"></div>
                                    <small class="form-text cie10-selection" aria-live="polite"></small>
                                </div>
                            </div>
                            <div class="col-12 form-text">Busca por código o descripción; el código se valida contra el catálogo CIE-10 al guardar.</div>
                        </div>
                    </div>

                    <!-- 4. PLAN -->
                    <div id="pane-plan" class="soap-pane tab-pane fade" role="tabpanel" aria-labelledby="soap-tab-plan">
                        <h6 class="text-secondary fw-bold mb-3">Plan Médico, Indicaciones y Prescripción</h6>
                        <div class="mb-3">
                            <label class="form-label fw-bold" for="diagnosticPlan">Exámenes de laboratorio, estudios y paraclínicos</label>
                            <textarea class="form-control" id="diagnosticPlan" name="diagnostic_plan" rows="3" placeholder="Anota los exámenes solicitados e instrucciones relevantes..."></textarea>
                            <div class="form-text">Conserva aquí el resumen narrativo del plan diagnóstico. Las órdenes estructuradas se registran por separado.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Órdenes estructuradas de estudios</label>
                            <div class="border rounded p-3">
                                <% if (studyCatalog.length) { %>
                                    <div class="row g-2">
                                        <% studyCatalog.forEach((study) => { %>
                                            <div class="col-md-6 col-lg-4">
                                                <label class="form-check">
                                                    <input class="form-check-input study-order-option" type="checkbox" name="study_ids" value="<%= study.id %>">
                                                    <span class="form-check-label"><strong><%= study.name %></strong><br><small class="text-muted"><%= study.category %> · <%= study.code || 'Sin código' %></small></span>
                                                </label>
                                            </div>
                                        <% }) %>
                                    </div>
                                    <div class="form-text mt-2">Al editar, las órdenes activas aparecen marcadas. Guardar no cancela ni modifica órdenes ya emitidas; solo agrega las que aún no estén activas.</div>
                                <% } else { %>
                                    <p class="text-muted mb-0">No hay estudios activos en el catálogo. Solicita que se cargue o habilite el catálogo antes de emitir órdenes.</p>
                                <% } %>
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label fw-bold" for="studyPriority">Prioridad para nuevas órdenes</label>
                                <select class="form-select" id="studyPriority" name="study_priority">
                                    <option value="routine">Rutina</option>
                                    <option value="urgent">Urgente</option>
                                    <option value="stat">Inmediata (STAT)</option>
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label fw-bold" for="studyInstructions">Indicaciones para nuevas órdenes</label>
                                <textarea class="form-control" id="studyInstructions" name="study_instructions" rows="2" maxlength="1000" placeholder="Preparación o indicaciones relevantes para los estudios seleccionados"></textarea>
                            </div>
