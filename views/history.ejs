<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EMR - Historia Clínica del Paciente</title>
    <!-- Bootstrap 5 CSS -->
    <link href="/assets/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            min-height: 100vh;
            background:
                radial-gradient(circle at 8% 8%, rgba(13, 110, 253, .08), transparent 28rem),
                linear-gradient(145deg, #f4f8fc 0%, #edf4f8 100%);
        }
        .soap-history-card {
            border: 1px solid rgba(255, 255, 255, .8);
            border-radius: 1rem;
            background: rgba(255, 255, 255, .84);
            box-shadow: 0 .75rem 2rem rgba(28, 57, 84, .08);
            backdrop-filter: blur(12px);
            overflow: hidden;
        }
        .soap-history-card .card-header {
            background: rgba(255, 255, 255, .68);
            border-bottom: 1px solid rgba(28, 57, 84, .08);
        }
        .soap-history-toggle {
            color: #17324d;
            text-align: left;
        }
        .soap-tab-btn {
            font-weight: bold;
        }
        .soap-draft-status {
            min-height: 2.5rem;
        }
        .cie10-suggestions {
            max-height: 16rem;
            overflow-y: auto;
            z-index: 1080;
        }
    </style>
</head>
<body class="bg-light">
<%- include('partials/navigation') %>

<div class="container my-5">
    <!-- Cabecera y Botón de Retorno -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h2 text-primary fw-bold mb-1">Expediente Clínico</h1>
            <p class="text-muted mb-0">Sistema de Atención Primaria (APS)</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <% if (currentUser.roles.includes('doctor')) { %>
                <a href="/appointments/today" class="btn btn-outline-success shadow-sm">← Agenda de hoy</a>
            <% } %>
            <a href="/pacientes" class="btn btn-secondary shadow-sm">Directorio general</a>
        </div>
    </div>

    <!-- Tarjeta de Datos del Paciente -->
    <div class="card shadow-sm border-0 mb-4" id="patient-demographics">
        <div class="card-header bg-primary text-white fw-bold">
            Información General del Paciente
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <span class="text-muted d-block">Nombre Completo:</span>
                    <strong class="fs-5 text-dark"><%= paciente.first_name %> <%= paciente.last_name %></strong>
                </div>
                <div class="col-md-3">
                    <span class="text-muted d-block">Documento (DNI):</span>
                    <code><%= paciente.dni_document %></code>
                </div>
                <div class="col-md-2">
                    <span class="text-muted d-block">Género:</span>
                    <span class="badge bg-secondary"><%= paciente.gender || 'N/D' %></span>
                </div>
                <div class="col-md-3">
                    <span class="text-muted d-block">Teléfono:</span>
                    <span><%= paciente.phone || 'N/A' %></span>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <% if (currentUser.roles.includes('doctor') && selectedAppointmentId && !selectedAppointmentConsultationId) { %>
            <button id="new-soap" class="btn btn-success shadow-sm fw-bold"
                    data-bs-toggle="modal" data-bs-target="#modalNuevaNotaSoap" onclick="limpiarModal()">
                + Registrar Nueva Evolución (SOAP)
            </button>
        <% } else if (currentUser.roles.includes('doctor') && selectedAppointmentConsultationId) { %>
            <div class="alert alert-info d-inline-block mb-0" role="status">
                La cita de hoy ya tiene una evolución; continúa desde la nota existente en el historial.
            </div>
        <% } else if (currentUser.roles.includes('doctor')) { %>
            <div class="alert alert-warning d-inline-block mb-0" role="status">
                Para iniciar una evolución, el paciente debe tener una cita activa contigo para hoy.
            </div>
        <% } %>
        <% if (currentUser.roles.includes('system_admin')) { %>
            <a class="btn btn-outline-primary ms-2" href="/admin/medications">Administrar catálogo de medicamentos</a>
        <% } %>
    </div>

    <!-- Historial Cronológico de Notas SOAP -->
    <section id="soap-history" aria-labelledby="soap-history-title">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 id="soap-history-title" class="h4 text-secondary fw-bold mb-0">Historial de Notas SOAP</h2>
        <span class="badge rounded-pill text-bg-primary">
            <%= notas.length %> <%= notas.length === 1 ? 'consulta' : 'consultas' %>
        </span>
    </div>
    
    <% if (notas.length > 0) { %>
        <% notas.forEach((nota, index) => { %>
            <article class="card soap-history-card mb-3">
                <div class="card-header d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2">
                    <button class="btn btn-link soap-history-toggle text-decoration-none fw-bold p-0"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#soap-consultation-<%= nota.id %>"
                            aria-expanded="<%= index === 0 ? 'true' : 'false' %>"
                            aria-controls="soap-consultation-<%= nota.id %>">
                        <span>Evolución #<%= notas.length - index %></span>
                        <span class="text-muted fw-normal">· <%= new Date(nota.consultation_date).toLocaleString('es-ES') %></span>
                    </button>
                    <div class="d-flex flex-wrap align-items-center gap-1">
                        <% if (nota.diagnoses.length) { nota.diagnoses.forEach((diagnosis) => { %>
                            <span class="badge bg-info text-dark"><%= diagnosis.type %>: <%= diagnosis.code %></span>
                        <% }) } else { %>
                            <span class="badge bg-secondary">Sin CIE-10</span>
                        <% } %>
                        
                        <!-- NUEVO: Botón para Imprimir Historia Completa (SOAP) -->
                        <a href="/patients/<%= paciente.id %>/full-history/<%= nota.id %>" target="_blank" rel="noopener" class="btn btn-sm btn-primary fw-bold shadow-sm">
                            📄 Historia Médica
                        </a>

                        <!-- Botón para Completar/Editar la evolución interrumpida -->
                        <% if (currentUser.roles.includes('doctor') && nota.soap_editable) { %>
                        <button type="button" id="edit-soap-<%= nota.id %>"
                            class="btn btn-sm btn-warning fw-bold text-dark shadow-sm"
                            data-edit-soap
                            data-id="<%= nota.id %>"
                            data-appointment-id="<%= nota.appointment_id || '' %>"
                            data-subjective="<%= nota.subjective || '' %>"
                            data-chief-complaint="<%= nota.chief_complaint || nota.subjective || '' %>"
                            data-current-illness="<%= nota.current_illness || '' %>"
                            data-relevant-background="<%= nota.relevant_background || '' %>"
                            data-objective="<%= nota.objective || '' %>"
                            data-assessment="<%= nota.assessment || '' %>"
                            data-plan="<%= nota.plan || '' %>"
                            data-diagnostic-plan="<%= nota.diagnostic_plan || '' %>"
                            data-therapeutic-plan="<%= nota.therapeutic_plan || '' %>"
                            data-education="<%= nota.education_recommendations || '' %>"
                            data-follow-up-date="<%= nota.follow_up_date ? new Date(nota.follow_up_date).toISOString().slice(0, 10) : '' %>"
                            data-bp="<%= nota.blood_pressure || '' %>"
                            data-hr="<%= nota.heart_rate || '' %>"
                            data-temp="<%= nota.temperature || '' %>"
                            data-weight="<%= nota.weight || '' %>"
                            data-height="<%= nota.height || '' %>"
                            data-respiratory-rate="<%= nota.respiratory_rate || '' %>"
                            data-oxygen-saturation="<%= nota.oxygen_saturation || '' %>"
                            data-lab-results-summary="<%= nota.lab_results_summary || '' %>"
                            data-cie10-primary="<%= nota.primary_cie_code || (nota.cie10_code !== 'N/A' ? nota.cie10_code : '') %>"
                            data-cie10-primary-description="<%= nota.primary_cie_description || nota.cie10_description || '' %>"
                            data-cie10-secondary="<%= nota.secondary_cie_code || '' %>"
                            data-cie10-secondary-description="<%= nota.secondary_cie_description || '' %>"
                            data-cie10-tertiary="<%= nota.tertiary_cie_code || '' %>"
                            data-cie10-tertiary-description="<%= nota.tertiary_cie_description || '' %>"
                            data-study-ids="<%= nota.studyOrders.filter(order => ['ordered', 'scheduled', 'in_progress'].includes(order.status)).map(order => order.study_id).join(',') %>">
                            ✏️ Modificar / Completar nota
                        </button>
                        <% } else if (currentUser.roles.includes('doctor')) { %>
                        <span class="badge text-bg-light border text-secondary"
                              title="La ventana de edición médica es de 24 horas desde el último guardado">
                            Solo lectura · ventana de edición cerrada
                        </span>
                        <% } %>
                    </div>
                </div>
                <div class="collapse <%= index === 0 ? 'show' : '' %>" id="soap-consultation-<%= nota.id %>">
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-3"><strong>Presión Arterial:</strong> <%= nota.blood_pressure || 'N/A' %></div>
                        <div class="col-md-3"><strong>F. Cardíaca:</strong> <%= nota.heart_rate ? nota.heart_rate + ' lpm' : 'N/A' %></div>
                        <div class="col-md-3"><strong>Temperatura:</strong> <%= nota.temperature ? nota.temperature + ' °C' : 'N/A' %></div>
                        <div class="col-md-3"><strong>IMC:</strong> <%= nota.bmi ? nota.bmi + ' (' + nota.bmi_status + ')' : 'N/A' %></div>
                    </div>
                    <hr>
                    <p><strong>(S) Motivo de consulta:</strong> <%= nota.chief_complaint || nota.subjective || 'Sin registro' %></p>
                    <% if (nota.current_illness) { %><p><strong>Enfermedad actual:</strong> <%= nota.current_illness %></p><% } %>
                    <% if (nota.relevant_background) { %><p><strong>Antecedentes relevantes:</strong> <%= nota.relevant_background %></p><% } %>
                    <p><strong>(O) Objetivo:</strong> <%= nota.objective %></p>
                    <% if (nota.lab_results_summary) { %><p><strong>Paraclínicos revisados:</strong> <%= nota.lab_results_summary %></p><% } %>
                    <% if (nota.respiratory_rate || nota.oxygen_saturation) { %>
                        <p><strong>FR:</strong> <%= nota.respiratory_rate || 'N/D' %> rpm · <strong>SpO₂:</strong> <%= nota.oxygen_saturation || 'N/D' %>%</p>
                    <% } %>
                    <p><strong>(A) Análisis:</strong> <%= nota.assessment %></p>
                    <% if (nota.diagnoses.length) { %>
                        <ul class="mb-3">
                            <% nota.diagnoses.forEach((diagnosis) => { %>
                                <li><strong><%= diagnosis.type %>:</strong> <%= diagnosis.code %> — <%= diagnosis.description || 'Sin descripción' %></li>
                            <% }) %>
                        </ul>
                    <% } %>
                    <% if (nota.diagnostic_plan) { %><p><strong>Exámenes y paraclínicos:</strong> <%= nota.diagnostic_plan %></p><% } %>
                    <% if (nota.studyOrders.length) { %>
                        <div class="mb-3">
                            <strong>Órdenes de estudios:</strong>
                            <ul class="mb-0">
                                <% nota.studyOrders.forEach((order) => { %>
                                    <li>
                                        <%= order.name %> (<%= order.category %>) —
                                        prioridad <%= { routine: 'Rutina', urgent: 'Urgente', stat: 'Inmediata (STAT)' }[order.priority] || order.priority %>,
                                        estado <%= { ordered: 'Solicitada', scheduled: 'Programada', in_progress: 'En proceso', completed: 'Completada', cancelled: 'Cancelada' }[order.status] || order.status %>
                                        <% if (order.instructions) { %> · Indicaciones: <%= order.instructions %><% } %>
                                    </li>
                                <% }) %>
                            </ul>
                        </div>
                    <% } %>
                    <section class="border rounded p-3 my-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                            <h6 class="fw-bold mb-0">Prescripción electrónica</h6>
                            <% if (medicationCatalog.length === 0) { %>
                                <span class="small text-muted">Catálogo local vacío; puedes usar texto libre.</span>
                            <% } %>
                        </div>
                        <% if (nota.prescriptions.length) { %>
                            <% nota.prescriptions.forEach((prescription) => { %>
                                <div class="card mb-2">
                                    <div class="card-body py-2">
                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <div>
                                                <strong>Receta #<%= prescription.id %></strong>
                                                <span class="badge <%= prescription.status === 'active' ? 'bg-success' : prescription.status === 'draft' ? 'bg-warning text-dark' : 'bg-secondary' %>">
                                                    <%= { draft: 'Borrador', active: 'Activa', cancelled: 'Cancelada', completed: 'Completada' }[prescription.status] || prescription.status %>
                                                </span>
                                                <small class="text-muted ms-2">Elaborada por <%= prescription.prescribed_by_name %> · <%= new Date(prescription.created_at).toLocaleString() %></small>
                                            </div>
                                            <% if (prescription.status === 'active' && prescription.signed_at) { %>
                                                <a class="btn btn-sm btn-outline-danger" target="_blank" href="/patients/<%= paciente.id %>/prescriptions/<%= prescription.id %>/pdf">Ver receta PDF</a>
                                            <% } %>
                                        </div>
                                        <ul class="small my-2">
                                            <% prescription.items.forEach((item) => { %>
                                                <li>
                                                    <strong><%= item.medication_name %><%= item.strength ? ` — ${item.strength}` : '' %></strong>:
                                                    <%= item.dose %><%= item.route ? ` · vía ${item.route}` : '' %> · <%= item.frequency %>
                                                    <% if (item.duration) { %> · duración: <%= item.duration %><% } %>
                                                    <% if (item.quantity) { %> · cantidad: <%= item.quantity %><% } %>
                                                    <% if (item.instructions) { %> · <%= item.instructions %><% } %>
                                                </li>
                                            <% }) %>
                                        </ul>
                                        <% if (prescription.instructions) { %><p class="small mb-2"><strong>Indicaciones generales:</strong> <%= prescription.instructions %></p><% } %>
                                        <% if (prescription.status === 'active' && prescription.signed_at) { %>
                                            <small class="text-muted">Confirmada por <%= prescription.prescribed_by_name %> el <%= new Date(prescription.signed_at).toLocaleString() %>. Registro de confirmación; no representa firma digital certificada.</small>
                                        <% } else if (prescription.status === 'draft' && currentUser.roles.includes('doctor') && prescription.prescribed_by_user_id === currentUser.id) { %>
                                            <form class="mt-2" method="POST" action="/patients/<%= paciente.id %>/prescriptions/<%= prescription.id %>/sign">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <div class="form-check mb-2">
                                                    <input class="form-check-input" type="checkbox" name="confirm_prescription" value="on" id="confirmPrescription<%= prescription.id %>" required>
                                                    <label class="form-check-label small" for="confirmPrescription<%= prescription.id %>">Confirmo que revisé y autorizo esta receta. La activación registrará mi usuario y fecha; no es una firma digital certificada.</label>
                                                </div>
                                                <button class="btn btn-sm btn-success" type="submit">Confirmar y activar receta</button>
                                            </form>
                                            <form class="mt-2" method="POST" action="/patients/<%= paciente.id %>/prescriptions/<%= prescription.id %>/cancel" onsubmit="return confirm('¿Cancelar este borrador? Quedará registrado y no podrá activarse.');">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button class="btn btn-sm btn-outline-danger" type="submit">Cancelar borrador</button>
                                            </form>
                                        <% } %>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <p class="small text-muted">Aún no hay recetas registradas para esta consulta.</p>
                        <% } %>
                        <% if (currentUser.roles.includes('doctor')) { %>
                            <form method="POST" action="/patients/<%= paciente.id %>/consultations/<%= nota.id %>/prescriptions" class="prescription-draft-form mt-3">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <div class="prescription-items">
                                    <div class="prescription-item border rounded p-3 mb-2">
                                        <div class="row g-2">
                                            <div class="col-md-6">
                                                <label class="form-label">Catálogo local (opcional)</label>
                                                <select class="form-select medication-catalog-select" name="items[0][medication_id]">
                                                    <option value="">No catalogado / escribir manualmente</option>
                                                    <% medicationCatalog.forEach((medication) => { %>
                                                        <option value="<%= medication.id %>"
                                                            data-name="<%= medication.name %>"
                                                            data-strength="<%= medication.strength || '' %>"
                                                            data-route="<%= medication.route || '' %>">
                                                            <%= medication.name %><%= medication.strength ? ` — ${medication.strength}` : '' %><%= medication.dosage_form ? ` (${medication.dosage_form})` : '' %>
                                                        </option>
                                                    <% }) %>
                                                </select>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">Medicamento / nombre genérico o comercial</label>
                                                <input class="form-control" name="items[0][medication_name]" maxlength="180" required>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label">Concentración</label>
                                                <input class="form-control" name="items[0][strength]" maxlength="100">
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label">Dosis <span class="text-danger">*</span></label>
                                                <input class="form-control" name="items[0][dose]" maxlength="100" required>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label">Vía</label>
                                                <input class="form-control" name="items[0][route]" maxlength="80">
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label">Frecuencia <span class="text-danger">*</span></label>
                                                <input class="form-control" name="items[0][frequency]" maxlength="120" required>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label">Duración</label>
                                                <input class="form-control" name="items[0][duration]" maxlength="100">
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label">Cantidad</label>
                                                <input class="form-control" name="items[0][quantity]" type="number" min="0.01" step="0.01">
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">Indicaciones del medicamento</label>
                                                <input class="form-control" name="items[0][instructions]" maxlength="1000">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <template class="prescription-item-template">
                                    <div class="prescription-item border rounded p-3 mb-2">
                                        <div class="d-flex justify-content-end mb-2">
                                            <button type="button" class="btn btn-sm btn-outline-danger remove-prescription-item">Quitar medicamento</button>
                                        </div>
                                        <div class="row g-2">
                                            <div class="col-md-6">
                                                <label class="form-label">Catálogo local (opcional)</label>
                                                <select class="form-select medication-catalog-select" name="items[__INDEX__][medication_id]">
                                                    <option value="">No catalogado / escribir manualmente</option>
                                                    <% medicationCatalog.forEach((medication) => { %>
                                                        <option value="<%= medication.id %>" data-name="<%= medication.name %>" data-strength="<%= medication.strength || '' %>" data-route="<%= medication.route || '' %>"><%= medication.name %><%= medication.strength ? ` — ${medication.strength}` : '' %><%= medication.dosage_form ? ` (${medication.dosage_form})` : '' %></option>
                                                    <% }) %>
                                                </select>
                                            </div>
                                            <div class="col-md-6"><label class="form-label">Medicamento / nombre genérico o comercial</label><input class="form-control" name="items[__INDEX__][medication_name]" maxlength="180" required></div>
                                            <div class="col-md-3"><label class="form-label">Concentración</label><input class="form-control" name="items[__INDEX__][strength]" maxlength="100"></div>
                                            <div class="col-md-3"><label class="form-label">Dosis <span class="text-danger">*</span></label><input class="form-control" name="items[__INDEX__][dose]" maxlength="100" required></div>
                                            <div class="col-md-3"><label class="form-label">Vía</label><input class="form-control" name="items[__INDEX__][route]" maxlength="80"></div>
                                            <div class="col-md-3"><label class="form-label">Frecuencia <span class="text-danger">*</span></label><input class="form-control" name="items[__INDEX__][frequency]" maxlength="120" required></div>
                                            <div class="col-md-3"><label class="form-label">Duración</label><input class="form-control" name="items[__INDEX__][duration]" maxlength="100"></div>
                                            <div class="col-md-3"><label class="form-label">Cantidad</label><input class="form-control" name="items[__INDEX__][quantity]" type="number" min="0.01" step="0.01"></div>
                                            <div class="col-md-6"><label class="form-label">Indicaciones del medicamento</label><input class="form-control" name="items[__INDEX__][instructions]" maxlength="1000"></div>
                                        </div>
                                    </div>
                                </template>
                                <button type="button" class="btn btn-sm btn-outline-primary add-prescription-item">+ Agregar medicamento</button>
                                <div class="mt-3">
                                    <label class="form-label" for="prescriptionInstructions<%= nota.id %>">Indicaciones generales de la receta</label>
                                    <textarea class="form-control" id="prescriptionInstructions<%= nota.id %>" name="prescription_instructions" rows="2" maxlength="2000"></textarea>
                                </div>
                                <p class="form-text mt-2">Se guardará como borrador. No será una receta activa hasta la confirmación explícita del médico que la creó. Revise los datos clínicos y posología; el sistema no recomienda dosis.</p>
                                <button class="btn btn-sm btn-outline-success mt-2" type="submit">Guardar borrador de receta</button>
                            </form>
                        <% } %>
                    </section>
                    <p><strong>(P) Tratamiento e indicaciones:</strong> <%= nota.therapeutic_plan || nota.plan %></p>
                    <% if (nota.education_recommendations) { %><p><strong>Educación:</strong> <%= nota.education_recommendations %></p><% } %>
                    <% if (nota.follow_up_date) { %><p class="mb-0"><strong>Seguimiento:</strong> <%= new Date(nota.follow_up_date).toLocaleDateString('es-VE', { timeZone: 'UTC' }) %></p><% } %>
                </div>
                </div>
            </article>
        <% }) %>
    <% } else { %>
        <div class="card shadow-sm border-0 p-4 text-center text-muted">
            <p class="mb-0">No hay notas SOAP registradas para este paciente todavía.</p>
        </div>
    <% } %>
    </section>
</div>

<!-- VENTANA MODAL: Formulario de Nueva Nota SOAP con Pestañas Robustas -->
<div class="modal fade" id="modalNuevaNotaSoap" tabindex="-1" aria-labelledby="modalSoapLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <form action="/patients/<%= paciente.id %>/soap" method="POST" id="formSoap">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                
                <!-- CAMPO OCULTO: Permite al backend identificar si se está actualizando una consulta existente -->
                <input type="hidden" id="consultation_id" name="consultation_id" value="">
                <input type="hidden" id="appointment_id" name="appointment_id"
                       value="<%= selectedAppointmentId || '' %>"
                       data-requested-appointment-id="<%= selectedAppointmentId || '' %>">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold" id="modalSoapLabel">Nueva Evolución Clínica - Estructura SOAP</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    
                    <!-- BOTONES DE NAVEGACIÓN (PESTAÑAS) -->
                    <div class="nav nav-pills flex-wrap gap-2 mb-3" role="tablist" aria-label="Secciones de la evolución SOAP">
                        <button type="button" class="nav-link soap-tab-btn active" id="soap-tab-subjetivo"
                                data-bs-toggle="tab" data-bs-target="#pane-subjetivo" role="tab"
                                aria-controls="pane-subjetivo" aria-selected="true">1. (S) Subjetivo</button>
                        <button type="button" class="nav-link soap-tab-btn" id="soap-tab-objetivo"
                                data-bs-toggle="tab" data-bs-target="#pane-objetivo" role="tab"
                                aria-controls="pane-objetivo" aria-selected="false">2. (O) Objetivo y Signos Vitales</button>
                        <button type="button" class="nav-link soap-tab-btn" id="soap-tab-analisis"
                                data-bs-toggle="tab" data-bs-target="#pane-analisis" role="tab"
                                aria-controls="pane-analisis" aria-selected="false">3. (A) Análisis y CIE-10</button>
                        <button type="button" class="nav-link soap-tab-btn" id="soap-tab-plan"
                                data-bs-toggle="tab" data-bs-target="#pane-plan" role="tab"
                                aria-controls="pane-plan" aria-selected="false">4. (P) Plan y Tratamiento</button>
                    </div>
                    <div id="soapDraftStatus" class="alert alert-info soap-draft-status py-2 mb-3"
                         role="status" aria-live="polite">
                        El borrador se guarda automáticamente de forma segura.
                    </div>

                    <!-- CONTENEDORES DE CADA PASO SOAP -->
                    <div class="tab-content">
                    <!-- 1. SUBJETIVO -->
                    <div id="pane-subjetivo" class="soap-pane tab-pane fade show active" role="tabpanel" aria-labelledby="soap-tab-subjetivo">
                        <h6 class="text-secondary fw-bold mb-3">Síntomas, enfermedad actual y antecedentes</h6>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-bold mb-0">(S) Motivo y síntomas referidos:</label>
                            </div>
                            <textarea class="form-control" id="subjective_text" name="chief_complaint" rows="3" placeholder="Síntomas y motivo principal de consulta..."></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold" for="currentIllness">Enfermedad actual y evolución</label>
                            <textarea class="form-control" id="currentIllness" name="current_illness" rows="3" placeholder="Inicio, duración, evolución y factores asociados..."></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold" for="relevantBackground">Antecedentes relevantes</label>
                            <textarea class="form-control" id="relevantBackground" name="relevant_background" rows="3" placeholder="Antecedentes personales, familiares, medicamentos y alergias pertinentes..."></textarea>
                        </div>
                    </div>

                    <!-- 2. OBJETIVO -->
                    <div id="pane-objetivo" class="soap-pane tab-pane fade" role="tabpanel" aria-labelledby="soap-tab-objetivo">
                        <h6 class="text-secondary fw-bold mb-3">Registro de Signos Vitales y Medidas Antropométricas</h6>
                        <div class="row g-3 mb-3">
                            <div class="col-md-3">
                                <label class="form-label fw-bold">Presión Arterial:</label>
                                <input type="text" class="form-control" name="blood_pressure" placeholder="Ej: 120/80">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-bold">Frecuencia Cardíaca (lpm):</label>
                                <input type="number" class="form-control" name="heart_rate" placeholder="Ej: 75">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-bold">Temperatura (°C):</label>
                                <input type="number" step="0.01" class="form-control" name="temperature" placeholder="Ej: 36.5">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-bold">Peso (kg):</label>
                                <input type="number" step="0.01" class="form-control" name="weight" placeholder="Ej: 70.5">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-bold">Talla (m):</label>
                                <input type="number" step="0.01" class="form-control" name="height" placeholder="Ej: 1.75">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-bold">Frecuencia respiratoria (rpm):</label>
                                <input type="number" min="1" class="form-control" name="respiratory_rate">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-bold">Saturación de oxígeno (%):</label>
                                <input type="number" min="0" max="100" class="form-control" name="oxygen_saturation">
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-bold mb-0">Descripción Física / Examen Físico Adicional:</label>
                            </div>
                            <textarea class="form-control" id="objective_text" name="objective" rows="4" placeholder="Hallazgos al examen físico..."></textarea>
                        </div>
                    </div>

                    <!-- 3. ANÁLISIS -->
