                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-bold mb-0">(P) Tratamiento e indicaciones:</label>
                            </div>
                            <textarea class="form-control" id="plan_text" name="plan" rows="6" placeholder="Medicación recetada, exámenes complementarios solicitados, indicaciones y reposo..."></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold" for="educationRecommendations">Educación y recomendaciones al paciente</label>
                            <textarea class="form-control" id="educationRecommendations" name="education_recommendations" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold" for="followUpDate">Fecha de seguimiento sugerida</label>
                            <input type="date" class="form-control" id="followUpDate" name="follow_up_date">
                        </div>
                    </div>

                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success fw-bold">Guardar / Actualizar Evolución</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Bootstrap 5 JS Bundle y Scripts de Control -->
<script src="/assets/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/assets/js/cie10-autocomplete.js"></script>
<script src="/assets/js/soap-csrf.js"></script>
<script>
    const soapDraftPatientId = <%- JSON.stringify(paciente.id) %>;
    const soapDraftUrl = `/patients/${encodeURIComponent(soapDraftPatientId)}/soap-draft`;
    const soapForm = document.getElementById('formSoap');
    const soapCsrfClient = window.SIGEMEDSoapCsrf.createSoapCsrfClient({
        fetchImpl: window.fetch.bind(window),
        getToken: () => soapForm.elements._csrf.value,
        setToken: (token) => {
            document.querySelectorAll('input[name="_csrf"]').forEach((input) => {
                input.value = token;
            });
        },
    });
    const soapModal = document.getElementById('modalNuevaNotaSoap');
    const soapDraftStatus = document.getElementById('soapDraftStatus');
    let soapDraftTimer;
    let soapDraftSaveChain = Promise.resolve(true);
    let soapDraftRestoring = false;
    let soapDraftEditedWhileRestoring = false;
    let soapAllowSubmit = false;
    let soapLastSavedSnapshot = null;
    // Administra la captura, restauración y sincronización segura del borrador SOAP.
    function setSoapDraftStatus(message, status = 'info') {
        soapDraftStatus.className = `alert alert-${status} soap-draft-status py-2 mb-3`;
        soapDraftStatus.textContent = message;
    }

    function soapRequestErrorMessage(error, fallback) {
        if (error.code === 'session_expired') {
            return 'La sesión expiró. Inicia sesión nuevamente para continuar.';
        }
        if (error.message === 'csrf_token_mismatch') {
            return 'No se pudo sincronizar la seguridad de la sesión. Actualiza la página e inténtalo de nuevo.';
        }
        return error.message || fallback;
    }

    function collectSoapDraft() {
        const data = {};
        soapForm.querySelectorAll('[name]').forEach((field) => {
            if (field.name === '_csrf' || field.name === 'consultation_id' || field.name === 'appointment_id') return;
            if (field.name === 'study_ids') return;
            data[field.name] = field.value;
        });
        document.querySelectorAll('.cie10-autocomplete').forEach((container) => {
            const input = container.querySelector('.cie10-code');
            const canonicalCode = container.querySelector('.cie10-canonical-code');
            const description = container.querySelector('.cie10-canonical-description');
            data[`${canonicalCode.dataset.canonicalName}_description`] = description.value;
            if (!canonicalCode.value && input.value.trim()) {
                data[canonicalCode.dataset.canonicalName] = input.value.trim();
            }
        });
        data.study_ids = [...soapForm.querySelectorAll('.study-order-option:checked')].map((field) => field.value);
        return {
            consultation_id: soapForm.elements.consultation_id.value || null,
            data,
        };
    }

    function soapDraftHasContent(data) {
        return Object.entries(data).some(([key, value]) => (
            key === 'study_ids' ? value.length > 0 : String(value).trim().length > 0
        ));
    }

    function applySoapDraft(data) {
        Object.entries(data).forEach(([name, value]) => {
            if (name === 'study_ids') {
                const selectedIds = new Set(value);
                soapForm.querySelectorAll('.study-order-option').forEach((field) => {
                    field.checked = selectedIds.has(field.value);
                });
                return;
            }
            if (name.endsWith('_description')) {
                const canonicalName = name.slice(0, -'_description'.length);
                const codeField = document.querySelector(
                    `.cie10-canonical-code[data-canonical-name="${canonicalName}"]`
                );
                const description = codeField?.closest('.cie10-autocomplete')
                    .querySelector('.cie10-canonical-description');
                if (description && typeof value === 'string') description.value = value;
                return;
            }
            const field = soapForm.elements.namedItem(name);
            if (field && typeof value === 'string') field.value = value;
        });
        document.querySelectorAll('.cie10-autocomplete').forEach((container) => {
            const input = container.querySelector('.cie10-code');
            const canonicalCode = container.querySelector('.cie10-canonical-code');
            const description = container.querySelector('.cie10-canonical-description');
            if (canonicalCode.value) {
                input.value = description.value
                    ? `${canonicalCode.value} - ${description.value}`
                    : canonicalCode.value;
                input.dataset.selectedCode = canonicalCode.value;
                input.dataset.selectedDisplay = input.value;
            }
        });
    }

    async function restoreSoapDraft() {
        const context = collectSoapDraft().consultation_id || '';
        soapDraftEditedWhileRestoring = false;
        soapDraftRestoring = true;
        soapLastSavedSnapshot = JSON.stringify(collectSoapDraft());
        setSoapDraftStatus('Buscando un borrador guardado…');
        try {
            const response = await fetch(`${soapDraftUrl}?consultation_id=${encodeURIComponent(context)}`, {
                credentials: 'same-origin',
                cache: 'no-store',
                headers: { Accept: 'application/json' },
            });
            if (!response.ok) throw new Error('No se pudo consultar el borrador.');
            const result = await response.json();
            if (soapDraftEditedWhileRestoring || (collectSoapDraft().consultation_id || '') !== context) return;
            if (result.draft) {
                applySoapDraft(result.draft);
                const savedAt = new Date(result.updated_at);
                const savedAtText = Number.isNaN(savedAt.getTime())
                    ? ''
                    : ` (${savedAt.toLocaleTimeString('es-VE', { hour: '2-digit', minute: '2-digit' })})`;
                setSoapDraftStatus(`Borrador recuperado automáticamente${savedAtText}.`, 'success');
            } else {
                setSoapDraftStatus('El borrador se guarda automáticamente de forma segura.', 'info');
            }
            soapLastSavedSnapshot = JSON.stringify(collectSoapDraft());
        } catch (error) {
            setSoapDraftStatus('No se pudo recuperar el borrador. Puedes continuar y guardar la evolución al finalizar.', 'warning');
            console.error('Error al recuperar borrador SOAP:', error);
        } finally {
            soapDraftRestoring = false;
            if (soapDraftEditedWhileRestoring) {
                soapDraftEditedWhileRestoring = false;
                scheduleSoapDraftSave();
            }
        }
    }

    async function sendSoapDraft(method, payload) {
        const { response, result } = await soapCsrfClient.request(soapDraftUrl + (payload.consultation_id
            ? `?consultation_id=${encodeURIComponent(payload.consultation_id)}`
            : ''), {
            method,
            headers: {
                Accept: 'application/json',
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(method === 'DELETE'
                ? {}
                : { consultation_id: payload.consultation_id, data: payload.data }),
        });
        if (!response.ok) throw new Error(result.error || 'No se pudo guardar el borrador.');
        return result;
    }

    async function saveSoapDraft() {
        if (soapDraftRestoring) return false;
        const payload = collectSoapDraft();
        const snapshot = JSON.stringify(payload);
        const saveOperation = soapDraftSaveChain.catch(() => false).then(async () => {
            if (snapshot === soapLastSavedSnapshot) return true;
            setSoapDraftStatus('Guardando borrador…');
            try {
                if (soapDraftHasContent(payload.data)) {
                    await sendSoapDraft('PUT', payload);
                } else {
                    await sendSoapDraft('DELETE', payload);
                }
                soapLastSavedSnapshot = snapshot;
                setSoapDraftStatus('Borrador guardado automáticamente.', 'success');
                return true;
            } catch (error) {
                setSoapDraftStatus(
                    soapRequestErrorMessage(
                        error,
                        'No se pudo guardar el borrador. Revisa la conexión; la evolución completa aún puede guardarse al finalizar.'
                    ),
                    error.code === 'session_expired' ? 'danger' : 'warning'
                );
                console.error('Error al guardar borrador SOAP:', error);
                return false;
            }
        });
        soapDraftSaveChain = saveOperation;
        return saveOperation;
    }

    function scheduleSoapDraftSave() {
        if (soapDraftRestoring) {
            soapDraftEditedWhileRestoring = true;
            return;
        }
        clearTimeout(soapDraftTimer);
        setSoapDraftStatus('Cambios pendientes de guardado…');
        soapDraftTimer = window.setTimeout(() => void saveSoapDraft(), 800);
    }

    soapModal.addEventListener('show.bs.modal', async () => {
        try {
            await soapCsrfClient.refreshToken();
        } catch (error) {
            if (error.code === 'session_expired') {
                setSoapDraftStatus('La sesión expiró. Inicia sesión nuevamente para editar esta evolución.', 'danger');
                return;
            }
            setSoapDraftStatus('No se pudo sincronizar la sesión. Actualiza la página antes de editar.', 'warning');
            console.error('Error al sincronizar CSRF al abrir SOAP:', error);
        }
        await restoreSoapDraft();
    });
    soapForm.addEventListener('input', scheduleSoapDraftSave);
    soapForm.addEventListener('change', scheduleSoapDraftSave);
    soapModal.addEventListener('hidden.bs.modal', () => {
        clearTimeout(soapDraftTimer);
        void saveSoapDraft();
    });
    document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') {
            clearTimeout(soapDraftTimer);
            void saveSoapDraft();
        }
    });
    window.setInterval(() => {
        if (soapModal.classList.contains('show')
            && !soapDraftRestoring
            && JSON.stringify(collectSoapDraft()) !== soapLastSavedSnapshot) {
            clearTimeout(soapDraftTimer);
            void saveSoapDraft();
        }
    }, 3000);
    soapForm.addEventListener('submit', async (event) => {
        if (soapAllowSubmit) {
            soapAllowSubmit = false;
            return;
        }
        event.preventDefault();
        clearTimeout(soapDraftTimer);
        await saveSoapDraft();
        try {
            await soapCsrfClient.refreshToken();
        } catch (error) {
            setSoapDraftStatus(
                soapRequestErrorMessage(error, 'No se pudo validar la sesión para guardar la evolución.'),
                'danger'
            );
            return;
        }
        soapAllowSubmit = true;
        if (event.submitter) soapForm.requestSubmit(event.submitter);
        else soapForm.requestSubmit();
    });

    if (new URLSearchParams(window.location.search).get('startSoap') === '1') {
        window.addEventListener('DOMContentLoaded', () => {
            const selectedConsultationId = <%- JSON.stringify(selectedAppointmentConsultationId || '') %>;
            const existingNoteButton = selectedConsultationId
                ? document.getElementById(`edit-soap-${selectedConsultationId}`)
                : null;
            if (existingNoteButton) cargarDatosEdicion(existingNoteButton);
            else if (selectedConsultationId) {
                setSoapDraftStatus(
                    'La nota vinculada a esta cita ya existe, pero está fuera de la ventana de edición. Está disponible en modo lectura.',
                    'warning'
                );
            }
            else {
                limpiarModal();
                bootstrap.Modal.getOrCreateInstance(document.getElementById('modalNuevaNotaSoap')).show();
            }
        });
    }

    // Limpiar modal al registrar nueva evolución
    function limpiarModal() {
        soapForm.reset();
        document.getElementById('consultation_id').value = '';
        const appointmentField = document.getElementById('appointment_id');
        appointmentField.value = appointmentField.dataset.requestedAppointmentId || '';
        document.querySelectorAll('.cie10-code').forEach((input) => {
            input.value = '';
            delete input.dataset.selectedCode;
            delete input.dataset.selectedDisplay;
            const canonicalCode = input.closest('.cie10-autocomplete').querySelector('.cie10-canonical-code');
            const canonicalDescription = input.closest('.cie10-autocomplete').querySelector('.cie10-canonical-description');
            canonicalCode.value = '';
            canonicalDescription.value = '';
            const selection = input.closest('.cie10-autocomplete').querySelector('.cie10-selection');
            selection.textContent = '';
            selection.classList.remove('text-success');
        });
        document.querySelectorAll('.cie10-suggestions').forEach((suggestions) => {
            suggestions.replaceChildren();
            suggestions.classList.add('d-none');
        });
        document.getElementById('modalSoapLabel').innerText = 'Nueva Evolución Clínica - Estructura SOAP';
        bootstrap.Tab.getOrCreateInstance(document.getElementById('soap-tab-subjetivo')).show();
    }

    function setCie10Diagnosis(inputName, code, description) {
        const input = document.querySelector(`.cie10-code[data-canonical-name="${inputName}"]`);
        const container = input.closest('.cie10-autocomplete');
        const canonicalCode = container.querySelector('.cie10-canonical-code');
        const canonicalDescription = container.querySelector('.cie10-canonical-description');
        const selection = container.querySelector('.cie10-selection');
        canonicalCode.value = _cleanNull(code).toUpperCase();
        canonicalDescription.value = canonicalCode.value ? _cleanNull(description) : '';
        if (canonicalCode.value) {
            input.value = window.SIGEMEDCie10Autocomplete.formatCie10Diagnosis({
                id: 1,
                code: canonicalCode.value,
                description: canonicalDescription.value,
            }) || canonicalCode.value;
            input.dataset.selectedCode = canonicalCode.value;
            input.dataset.selectedDisplay = input.value;
            selection.classList.add('text-success');
        } else {
            input.value = '';
            delete input.dataset.selectedCode;
            delete input.dataset.selectedDisplay;
            canonicalDescription.value = '';
            selection.textContent = '';
            selection.classList.remove('text-success');
        }
    }

    // Cargar datos en el modal para editar evolución interrumpida
    function cargarDatosEdicion(btn) {
        const consultationId = btn.getAttribute('data-id') || '';
        if (!/^[1-9]\d*$/.test(consultationId)) {
            throw new Error('El identificador de la nota SOAP no es válido.');
        }
        if (!soapForm || !soapModal || !soapForm.elements.consultation_id) {
            throw new Error('No se pudo inicializar el formulario de edición SOAP.');
        }
        soapForm.elements.consultation_id.value = consultationId;
        const appointmentField = document.getElementById('appointment_id');
        appointmentField.value = btn.getAttribute('data-appointment-id') || '';
        
        // Asignación de Textareas
        document.getElementById('subjective_text').value = _cleanNull(btn.getAttribute('data-chief-complaint'), 'Sin registro');
        document.getElementById('currentIllness').value = _cleanNull(btn.getAttribute('data-current-illness'));
        document.getElementById('relevantBackground').value = _cleanNull(btn.getAttribute('data-relevant-background'));
        document.getElementById('objective_text').value = _cleanNull(btn.getAttribute('data-objective'));
        document.getElementById('labResultsSummary').value = _cleanNull(btn.getAttribute('data-lab-results-summary'));
        document.getElementById('assessment_text').value = _cleanNull(btn.getAttribute('data-assessment'), 'Sin análisis');
        document.getElementById('plan_text').value = _cleanNull(btn.getAttribute('data-therapeutic-plan') || btn.getAttribute('data-plan'), 'Sin indicaciones');
        document.getElementById('diagnosticPlan').value = _cleanNull(btn.getAttribute('data-diagnostic-plan'));
        document.getElementById('educationRecommendations').value = _cleanNull(btn.getAttribute('data-education'));
        document.getElementById('followUpDate').value = _cleanNull(btn.getAttribute('data-follow-up-date'));
        
        // Asignación de Inputs
        document.querySelector('[name="blood_pressure"]').value = _cleanNull(btn.getAttribute('data-bp'));
        document.querySelector('[name="heart_rate"]').value = _cleanNull(btn.getAttribute('data-hr'));
        document.querySelector('[name="temperature"]').value = _cleanNull(btn.getAttribute('data-temp'));
        document.querySelector('[name="weight"]').value = _cleanNull(btn.getAttribute('data-weight'));
        document.querySelector('[name="height"]').value = _cleanNull(btn.getAttribute('data-height'));
        document.querySelector('[name="respiratory_rate"]').value = _cleanNull(btn.getAttribute('data-respiratory-rate'));
        document.querySelector('[name="oxygen_saturation"]').value = _cleanNull(btn.getAttribute('data-oxygen-saturation'));
        setCie10Diagnosis('cie10_primary_code', btn.getAttribute('data-cie10-primary'), btn.getAttribute('data-cie10-primary-description'));
        setCie10Diagnosis('cie10_secondary_code', btn.getAttribute('data-cie10-secondary'), btn.getAttribute('data-cie10-secondary-description'));
        setCie10Diagnosis('cie10_tertiary_code', btn.getAttribute('data-cie10-tertiary'), btn.getAttribute('data-cie10-tertiary-description'));
        const activeStudyIds = new Set((btn.getAttribute('data-study-ids') || '').split(',').filter(Boolean));
        document.querySelectorAll('.study-order-option').forEach((checkbox) => {
            checkbox.checked = activeStudyIds.has(checkbox.value);
        });
        document.getElementById('studyPriority').value = 'routine';
        document.getElementById('studyInstructions').value = '';

        document.getElementById('modalSoapLabel').innerText = 'Completar Evolución Clínica (Edición)';
        setSoapDraftStatus('Nota cargada para completar o modificar. Se solicitará verificación por correo al guardar.');
        bootstrap.Modal.getOrCreateInstance(soapModal).show();
    }

    document.addEventListener('click', (event) => {
        const button = event.target.closest('[data-edit-soap]');
        if (!button) return;

        try {
            cargarDatosEdicion(button);
        } catch (error) {
            console.error('No se pudo abrir la nota SOAP para edición:', error);
            setSoapDraftStatus(error.message || 'No se pudo abrir la nota para edición.', 'danger');
        }
    });

    // Función auxiliar para evitar imprimir la palabra "null"
    function _cleanNull(val, defaultText = '') {
        return (val && val !== 'null' && val !== defaultText) ? val : '';
    }

    document.querySelectorAll('.prescription-draft-form').forEach((form) => {
        let nextIndex = 1;
        form.querySelector('.add-prescription-item').addEventListener('click', () => {
            const template = form.querySelector('.prescription-item-template');
            const item = template.content.firstElementChild.cloneNode(true);
            item.querySelectorAll('[name]').forEach((field) => {
                field.name = field.name.replaceAll('__INDEX__', String(nextIndex));
            });
            nextIndex += 1;
            form.querySelector('.prescription-items').append(item);
        });
        form.addEventListener('click', (event) => {
            const removeButton = event.target.closest('.remove-prescription-item');
            if (removeButton) removeButton.closest('.prescription-item').remove();
        });
        form.addEventListener('change', (event) => {
            const select = event.target.closest('.medication-catalog-select');
            if (!select || !select.value) return;
            const row = select.closest('.prescription-item');
            const option = select.selectedOptions[0];
            row.querySelector('[name$="[medication_name]"]').value = option.dataset.name || '';
            row.querySelector('[name$="[strength]"]').value = option.dataset.strength || '';
            row.querySelector('[name$="[route]"]').value = option.dataset.route || '';
        });
    });

    document.querySelectorAll('.cie10-autocomplete').forEach((container) => {
        const input = container.querySelector('.cie10-code');
        const suggestions = container.querySelector('.cie10-suggestions');
        const selectedDescription = container.querySelector('.cie10-selection');
        let request;
        let debounceTimer;
        let activeIndex = -1;
        let results = [];
        let latestRequestId = 0;

        function closeSuggestions() {
            suggestions.replaceChildren();
            suggestions.classList.add('d-none');
            input.setAttribute('aria-expanded', 'false');
            input.removeAttribute('aria-activedescendant');
            activeIndex = -1;
            results = [];
        }

        function selectDiagnosis(diagnosis) {
            const canonicalDiagnosis = window.SIGEMEDCie10Autocomplete
                .canonicalizeCie10Selection(diagnosis);
            if (!canonicalDiagnosis) {
                closeSuggestions();
                selectedDescription.textContent = 'La sugerencia CIE-10 recibida no es válida.';
                selectedDescription.classList.remove('text-success');
                console.error('El catálogo devolvió una sugerencia CIE-10 inválida.');
                return;
            }
            const canonicalCode = container.querySelector('.cie10-canonical-code');
            const canonicalDescriptionField = container.querySelector('.cie10-canonical-description');
            canonicalCode.value = canonicalDiagnosis.code;
            canonicalDescriptionField.value = canonicalDiagnosis.description.trim();
            input.value = window.SIGEMEDCie10Autocomplete.formatCie10Diagnosis(canonicalDiagnosis);
            selectedDescription.textContent = `${canonicalDiagnosis.code} — ${canonicalDiagnosis.description}`;
            selectedDescription.classList.add('text-success');
            input.dataset.selectedCode = canonicalDiagnosis.code;
            input.dataset.selectedDisplay = input.value;
            closeSuggestions();
            input.dataset.skipCie10Search = 'true';
            input.dispatchEvent(new Event('input', { bubbles: true }));
        }

        function setActiveOption(nextIndex) {
            const options = [...suggestions.querySelectorAll('[role="option"]')];
            if (!options.length) return;
            activeIndex = (nextIndex + options.length) % options.length;
            options.forEach((option, index) => {
                option.classList.toggle('active', index === activeIndex);
                option.setAttribute('aria-selected', String(index === activeIndex));
            });
            input.setAttribute('aria-activedescendant', options[activeIndex].id);
        }

        function renderSuggestions(diagnoses, query) {
            results = diagnoses;
            activeIndex = -1;
            if (!diagnoses.length) {
                const emptyState = document.createElement('div');
                emptyState.className = 'list-group-item small text-muted';
                emptyState.textContent = `No se encontraron diagnósticos para “${query}”.`;
                suggestions.replaceChildren(emptyState);
                suggestions.classList.remove('d-none');
                input.setAttribute('aria-expanded', 'true');
                return;
            }

            suggestions.replaceChildren(...diagnoses.map((diagnosis, index) => {
                const option = document.createElement('button');
                option.type = 'button';
                option.id = `${input.id}-option-${index}`;
                option.className = 'list-group-item list-group-item-action';
                option.setAttribute('role', 'option');
                option.setAttribute('aria-selected', 'false');
                const code = document.createElement('strong');
                code.className = 'd-block';
                code.textContent = diagnosis.code;
                const description = document.createElement('span');
                description.className = 'small text-muted';
                description.textContent = diagnosis.description;
                option.append(code, description);
                option.addEventListener('mousedown', (event) => event.preventDefault());
                option.addEventListener('click', () => selectDiagnosis(diagnosis));
                return option;
            }));
            suggestions.classList.remove('d-none');
            input.setAttribute('aria-expanded', 'true');
        }

        input.addEventListener('input', () => {
            const requestId = ++latestRequestId;
            clearTimeout(debounceTimer);
            if (request) request.abort();
            if (input.dataset.skipCie10Search === 'true') {
                delete input.dataset.skipCie10Search;
                return;
            }
            const query = input.value.trim();
            const canonicalCode = container.querySelector('.cie10-canonical-code');
            const canonicalDescriptionField = container.querySelector('.cie10-canonical-description');
            if (input.dataset.selectedCode && input.dataset.selectedDisplay !== query) {
                delete input.dataset.selectedCode;
                delete input.dataset.selectedDisplay;
                selectedDescription.textContent = '';
                selectedDescription.classList.remove('text-success');
                canonicalDescriptionField.value = '';
            }
            canonicalCode.value = input.dataset.selectedCode && input.dataset.selectedDisplay === query
                ? input.dataset.selectedCode
                : query;
            if (query.length < 2) {
                closeSuggestions();
                return;
            }

            debounceTimer = window.setTimeout(async () => {
                request = new AbortController();
                try {
                    const response = await fetch(`/api/cie10/search?q=${encodeURIComponent(query)}`, {
                        headers: { Accept: 'application/json' },
                        cache: 'no-store',
                        signal: request.signal,
                    });
                    const contentType = response.headers.get('content-type') || '';
                    if (!response.ok || !contentType.includes('application/json')) {
                        throw new Error('No se pudo consultar el catálogo CIE-10.');
                    }
                    const diagnoses = await response.json();
                    if (!window.SIGEMEDCie10Autocomplete.isCurrentSearchResponse(
                        requestId,
                        latestRequestId,
                        query,
                        input.value.trim()
                    )) return;
                    renderSuggestions(diagnoses, query);
                } catch (error) {
                    if (error.name !== 'AbortError'
                        && window.SIGEMEDCie10Autocomplete.isCurrentSearchResponse(
                            requestId,
                            latestRequestId,
                            query,
                            input.value.trim()
                        )) {
                        closeSuggestions();
                        selectedDescription.textContent = 'No se pudo realizar la búsqueda. Inténtalo nuevamente.';
                        selectedDescription.classList.remove('text-success');
                        console.error('Error en el autocompletado CIE-10:', error);
                    }
                }
            }, 250);
        });

        input.addEventListener('keydown', (event) => {
            if (suggestions.classList.contains('d-none')) return;
            if (event.key === 'ArrowDown') {
                event.preventDefault();
                setActiveOption(activeIndex + 1);
            } else if (event.key === 'ArrowUp') {
                event.preventDefault();
                setActiveOption(activeIndex < 0 ? results.length - 1 : activeIndex - 1);
            } else if (event.key === 'Enter' && activeIndex >= 0) {
                event.preventDefault();
                selectDiagnosis(results[activeIndex]);
            } else if (event.key === 'Escape') {
                closeSuggestions();
            }
        });

        input.addEventListener('blur', () => {
            window.setTimeout(closeSuggestions, 150);
        });
    });
</script>

</body>
</html>