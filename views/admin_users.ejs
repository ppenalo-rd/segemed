<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Usuarios y accesos | SIGEMED</title>
    <link href="/assets/bootstrap/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<main class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="text-primary fw-semibold mb-1">Administración</p>
            <h1 class="h3 mb-0">Usuarios y accesos</h1>
        </div>
        <a class="btn btn-outline-secondary" href="/dashboard">Volver al menú principal</a>
    </div>

    <% if (message) { %><div class="alert alert-success" role="status"><%= message %></div><% } %>
    <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
    <div id="userUpdateFeedback" aria-live="polite"></div>

    <section class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <h2 class="h5 mb-3">Vincular cuenta médica existente</h2>
            <p class="text-muted">Vincula un perfil profesional con una cuenta activa que ya tenga el rol Médico. Esto habilita al profesional para recibir citas.</p>
            <% if (doctors.length && doctorAccounts.length) { %>
            <form action="/admin/users/link-doctor" method="POST" class="row g-3">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="col-md-5">
                    <label class="form-label" for="link_doctor_id">Perfil médico</label>
                    <select class="form-select" id="link_doctor_id" name="doctor_id" required>
                        <option value="">Seleccione médico...</option>
                        <% doctors.forEach((doctor) => { %>
                            <option value="<%= doctor.id %>"><%= doctor.name %> · <%= doctor.main_specialty %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="link_user_id">Cuenta con rol Médico</label>
                    <select class="form-select" id="link_user_id" name="user_id" required>
                        <option value="">Seleccione cuenta...</option>
                        <% doctorAccounts.forEach((account) => { %>
                            <option value="<%= account.id %>"><%= account.name %> · <%= account.email %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-outline-primary w-100" type="submit">Vincular</button>
                </div>
            </form>
            <% } %>
            <% if (!doctors.length) { %><p class="text-muted mb-0">No hay perfiles médicos activos sin vincular.</p><% } %>
            <% if (!doctorAccounts.length) { %><p class="text-muted mb-0">No hay cuentas activas con rol Médico disponibles para vincular.</p><% } %>
        </div>
    </section>

    <section class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <h2 class="h5 mb-3">Crear cuenta de acceso</h2>
            <form action="/admin/users" method="POST" class="row g-3">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="col-md-4">
                    <label class="form-label" for="name">Nombre</label>
                    <input class="form-control" id="name" name="name" required maxlength="120">
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="email">Correo electrónico</label>
                    <input class="form-control" id="email" name="email" type="email" required maxlength="160">
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="password">Contraseña temporal</label>
                    <input class="form-control" id="password" name="password" type="password" minlength="12" autocomplete="new-password" required>
                    <div class="form-text">Mínimo 12 caracteres; entrégala al usuario por un canal seguro.</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="role_key">Perfil</label>
                    <select class="form-select" id="role_key" name="role_key" required>
                        <% roles.forEach((role) => { %>
                            <option value="<%= role.role_key %>"><%= role.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="doctor_id">Vincular perfil médico (opcional)</label>
                    <select class="form-select" id="doctor_id" name="doctor_id">
                        <option value="">Sin vincular</option>
                        <% doctors.forEach((doctor) => { %>
                            <option value="<%= doctor.id %>"><%= doctor.name %> · <%= doctor.main_specialty %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-12">
                    <button class="btn btn-primary" type="submit">Crear cuenta</button>
                </div>
            </form>
        </div>
    </section>

    <section class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="p-4 pb-2"><h2 class="h5">Cuentas registradas</h2></div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light"><tr><th class="ps-4">Nombre</th><th>Correo</th><th>Perfiles</th><th>Estado</th><th class="text-end pe-4">Acciones</th></tr></thead>
                    <tbody>
                    <% accounts.forEach((account) => { %>
                        <tr>
                            <td class="ps-4"><%= account.name %></td>
                            <td><%= account.email %></td>
                            <td><%= account.roles || 'Sin perfil' %></td>
                            <td><span class="badge <%= account.active ? 'text-bg-success' : 'text-bg-secondary' %>"><%= account.active ? 'Activa' : 'Inactiva' %></span></td>
                            <td class="text-end pe-4">
                                <% if (isSystemAdmin) { %>
                                <button
                                    class="btn btn-sm btn-outline-danger"
                                    type="button"
                                    data-password-change
                                    data-password-change-url="/admin/users/<%= account.id %>/password-change/request"
                                    data-password-change-target="<%= account.name %>"
                                    aria-label="Cambiar contraseña de <%= account.name %>">
                                    Cambiar contraseña
                                </button>
                                <% } %>
                                <button
                                    class="btn btn-sm btn-outline-primary"
                                    type="button"
                                    data-edit-user
                                    data-user-id="<%= account.id %>"
                                    data-user-name="<%= account.name %>"
                                    data-user-email="<%= account.email %>"
                                    data-user-active="<%= account.active %>"
                                    data-user-role-keys="<%= JSON.stringify(account.role_keys || []) %>"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editUserModal"
                                    aria-label="Editar cuenta de <%= account.name %>">
                                    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M12.146.854a.5.5 0 0 1 .708 0l2.292 2.292a.5.5 0 0 1 0 .708l-9.5 9.5a.5.5 0 0 1-.217.128l-4 1a.5.5 0 0 1-.606-.606l1-4a.5.5 0 0 1 .128-.217l9.5-9.5ZM11.207 3 13 4.793 14.293 3.5 12.5 1.707 11.207 3Zm1.086 2.5L10.5 3.707l-7.5 7.5V13h1.793l7.5-7.5Z"/>
                                    </svg>
                                    Editar
                                </button>
                            </td>
                        </tr>
                    <% }) %>
                    <% if (accounts.length === 0) { %><tr><td colspan="5" class="text-center py-4 text-muted">No hay cuentas registradas.</td></tr><% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</main>
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form id="editUserForm" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="editUserModalLabel">Editar cuenta</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="edit_user_name">Nombre</label>
                            <input class="form-control" id="edit_user_name" name="name" maxlength="120" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="edit_user_email">Correo electrónico</label>
                            <input class="form-control" id="edit_user_email" name="email" type="email" maxlength="160" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="edit_user_active">Estado</label>
                            <select class="form-select" id="edit_user_active" name="active" required>
                                <option value="true">Activa</option>
                                <option value="false">Inactiva</option>
                            </select>
                        </div>
                        <fieldset class="col-12">
                            <legend class="form-label">Perfiles</legend>
                            <div class="row g-2">
                                <% roles.forEach((role) => { %>
                                    <div class="col-sm-6 col-lg-4">
                                        <div class="form-check">
                                            <input class="form-check-input edit-user-role" type="checkbox" name="role_keys" value="<%= role.role_key %>" id="edit_role_<%= role.role_key %>">
                                            <label class="form-check-label" for="edit_role_<%= role.role_key %>"><%= role.name %></label>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                            <div id="editRoleError" class="invalid-feedback d-block" role="alert" hidden>Selecciona al menos un perfil.</div>
                            <% if (!isSystemAdmin) { %>
                                <div class="form-text">Los perfiles fuera de tu ámbito de asignación se conservan sin cambios.</div>
                            <% } %>
                        </fieldset>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script src="/assets/bootstrap/js/bootstrap.bundle.min.js"></script>
<%- include('partials/password-change-modal') %>
<script>
(() => {
    const form = document.getElementById('editUserForm');
    const roleError = document.getElementById('editRoleError');
    const feedback = document.getElementById('userUpdateFeedback');
    const roleInputs = [...document.querySelectorAll('.edit-user-role')];
    const submitButton = form.querySelector('button[type="submit"]');
    const csrfToken = form.querySelector('input[name="_csrf"]').value;
    let activeEditButton = null;

    const showFeedback = (message, isError = false) => {
        feedback.className = `alert ${isError ? 'alert-danger' : 'alert-success'}`;
        feedback.setAttribute('role', isError ? 'alert' : 'status');
        feedback.textContent = message;
    };

    document.querySelectorAll('[data-edit-user]').forEach((button) => {
        button.addEventListener('click', () => {
            activeEditButton = button;
            form.action = `/admin/users/${encodeURIComponent(button.dataset.userId)}/update`;
            form.elements.name.value = button.dataset.userName;
            form.elements.email.value = button.dataset.userEmail;
            form.elements.active.value = button.dataset.userActive;
            const assignedRoles = JSON.parse(button.dataset.userRoleKeys || '[]');
            roleInputs.forEach((input) => {
                input.checked = assignedRoles.includes(input.value);
            });
            roleError.hidden = true;
        });
    });

    form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const hasSelectedRole = roleInputs.some((input) => input.checked);
        roleError.hidden = hasSelectedRole;
        if (!hasSelectedRole) return;

        submitButton.disabled = true;
        try {
            const response = await fetch(form.action, {
                method: 'PATCH',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': csrfToken,
                },
                body: JSON.stringify({
                    name: form.elements.name.value,
                    email: form.elements.email.value,
                    active: form.elements.active.value,
                    role_keys: roleInputs.filter((input) => input.checked).map((input) => input.value),
                }),
            });
            const result = await response.json();
            if (!response.ok) {
                const errorMessages = {
                    csrf_token_mismatch: 'La solicitud expiró. Actualiza la página e inténtalo de nuevo.',
                    email_conflict: 'Ese correo ya está asociado a otra cuenta.',
                    invalid_user_data: 'Revisa el nombre, correo, estado y perfiles seleccionados.',
                    role_constraint_mismatch: 'Los perfiles configurados aún no están habilitados en la base de datos. Aplica las migraciones de SIGEMED y vuelve a intentarlo.',
                    session_expired: 'La sesión expiró. Inicia sesión nuevamente.',
                    update_failed: 'No se pudo guardar el cambio. Inténtalo de nuevo.',
                    user_not_found: 'La cuenta ya no existe o fue eliminada.',
                };
                throw new Error(errorMessages[result.error] || 'No se pudo actualizar la cuenta.');
            }
            const account = result.account;
            const row = activeEditButton.closest('tr');
            const cells = row.querySelectorAll('td');
            cells[0].textContent = account.name;
            cells[1].textContent = account.email;
            cells[2].textContent = account.roles;
            const statusBadge = cells[3].querySelector('.badge');
            statusBadge.textContent = account.active ? 'Activa' : 'Inactiva';
            statusBadge.className = `badge ${account.active ? 'text-bg-success' : 'text-bg-secondary'}`;
            activeEditButton.dataset.userName = account.name;
            activeEditButton.dataset.userEmail = account.email;
            activeEditButton.dataset.userActive = account.active;
            activeEditButton.dataset.userRoleKeys = JSON.stringify(account.roleKeys);

            bootstrap.Modal.getOrCreateInstance(document.getElementById('editUserModal')).hide();
            showFeedback('La cuenta se actualizó correctamente.');
        } catch (error) {
            showFeedback(error.message || 'No se pudo actualizar la cuenta. Inténtalo de nuevo.', true);
        } finally {
            submitButton.disabled = false;
        }
    });
})();
</script>
</body>
</html>
