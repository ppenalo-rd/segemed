<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Menú principal | SIGEMED</title>
    <link href="/assets/bootstrap/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<%- include('partials/navigation') %>

<main class="container py-5">
    <header class="mb-4">
        <p class="text-primary fw-semibold mb-1">SIGEMED · Clínica ambulatoria</p>
        <h1 class="h2 fw-bold mb-2">Menú principal</h1>
        <p class="text-muted mb-0">Selecciona un módulo disponible para tu perfil.</p>
    </header>

    <% if (modules.length) { %>
        <section class="row g-4" aria-label="Módulos disponibles">
            <% modules.forEach((module) => { %>
                <div class="col-12 col-md-6 col-xl-4" data-module="<%= module.id %>">
                    <a class="card h-100 border-0 shadow-sm text-decoration-none text-dark"
                       href="<%= module.href %>">
                        <div class="card-body p-4">
                            <h2 class="h5 fw-bold"><%= module.title %></h2>
                            <p class="text-muted mb-0"><%= module.description %></p>
                        </div>
                        <div class="card-footer bg-white border-0 px-4 pb-4 pt-0">
                            <span class="text-primary fw-semibold">Abrir módulo <span aria-hidden="true">→</span></span>
                        </div>
                    </a>
                </div>
            <% }) %>
        </section>
    <% } else { %>
        <div class="alert alert-warning" role="status">
            Tu cuenta todavía no tiene módulos habilitados. Contacta al administrador del sistema.
        </div>
    <% } %>
</main>
</body>
</html>
