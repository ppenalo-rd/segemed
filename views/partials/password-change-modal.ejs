<div class="modal fade" id="passwordChangeModal" tabindex="-1" aria-labelledby="passwordChangeTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content password-change-glass rounded-4">
            <div class="modal-header border-0 pb-0">
                <div>
                    <p class="small text-primary fw-semibold mb-1">SIGEMED · Seguridad</p>
                    <h2 class="modal-title fs-5" id="passwordChangeTitle">Cambiar contraseña</h2>
                    <p class="small text-secondary mb-0" id="passwordChangeTarget"></p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div id="passwordChangeFeedback" role="status" aria-live="polite" hidden></div>
                <form id="passwordChangeRequestForm">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="mb-3">
                        <label class="form-label" for="newPassword">Nueva contraseña</label>
                        <input class="form-control" id="newPassword" name="new_password" type="password"
                               minlength="12" autocomplete="new-password" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="confirmPassword">Confirmar contraseña</label>
                        <input class="form-control" id="confirmPassword" name="confirm_password" type="password"
                               minlength="12" autocomplete="new-password" required>
                    </div>
                    <p class="form-text">Mínimo 12 caracteres, con mayúscula, minúscula y número. El código se enviará al correo registrado de la cuenta afectada.</p>
                    <button class="btn btn-primary w-100" type="submit">Enviar código de verificación</button>
                </form>
                <form id="passwordChangeVerifyForm" hidden>
                    <p class="text-secondary">Enviamos un código de 6 dígitos a <strong id="passwordChangeEmail"></strong>.</p>
                    <div class="mb-3">
                        <label class="form-label" for="passwordChangeOtp">Código de verificación</label>
                        <input class="form-control form-control-lg text-center fs-4 fw-bold"
                               style="letter-spacing:.5rem" id="passwordChangeOtp" name="otp" type="text"
                               inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}"
                               minlength="6" maxlength="6" required>
                        <div class="form-text">El código vence en <span id="passwordChangeCountdown">05:00</span>.</div>
                    </div>
                    <button class="btn btn-success w-100" type="submit">Verificar y cambiar contraseña</button>
                </form>
            </div>
        </div>
    </div>
</div>
<style>
    .password-change-glass {
        border: 1px solid rgba(255, 255, 255, .85);
        background: rgba(255, 255, 255, .94);
        box-shadow: 0 1.25rem 3.5rem rgba(23, 65, 110, .2);
        backdrop-filter: blur(16px);
    }
</style>
<script>
(() => {
    const modalElement = document.getElementById('passwordChangeModal');
    const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
    const requestForm = document.getElementById('passwordChangeRequestForm');
    const verifyForm = document.getElementById('passwordChangeVerifyForm');
    const feedback = document.getElementById('passwordChangeFeedback');
    const csrfInput = requestForm.querySelector('input[name="_csrf"]');
    const requestButton = requestForm.querySelector('button[type="submit"]');
    const verifyButton = verifyForm.querySelector('button[type="submit"]');
    let requestUrl = '';
    let expiresAt = 0;
    let countdownTimer = null;

    function showFeedback(message, isError = false) {
        feedback.hidden = false;
        feedback.className = `alert ${isError ? 'alert-danger' : 'alert-success'} mb-3`;
        feedback.textContent = message;
        feedback.setAttribute('role', isError ? 'alert' : 'status');
    }

    function updateCountdown() {
        const secondsLeft = Math.max(0, Math.ceil((expiresAt - Date.now()) / 1000));
        document.getElementById('passwordChangeCountdown').textContent =
            `${String(Math.floor(secondsLeft / 60)).padStart(2, '0')}:${String(secondsLeft % 60).padStart(2, '0')}`;
        if (!secondsLeft) {
            window.clearInterval(countdownTimer);
            verifyButton.disabled = true;
            showFeedback('El código venció. Cierra esta ventana y solicita un nuevo cambio.', true);
        }
    }

    async function readJson(response) {
        const result = await response.json();
        if (!response.ok) {
            const messages = {
                email_delivery_failed: 'No se pudo enviar el código. Inténtalo más tarde.',
                email_missing: 'La cuenta no tiene un correo registrado para recibir el código.',
                invalid_otp: 'El código no es válido. Verifícalo e inténtalo de nuevo.',
                invalid_password: result.message || 'La contraseña no cumple los requisitos.',
                otp_expired: 'El código venció. Solicita nuevamente el cambio.',
                otp_locked: 'Se agotaron los intentos. Solicita nuevamente el cambio más tarde.',
                otp_wait: 'Espera 60 segundos antes de solicitar otro código.',
                rate_limited: 'Se alcanzó el límite de solicitudes o verificaciones. Inténtalo más tarde.',
                session_expired: 'La sesión expiró. Inicia sesión nuevamente.',
                user_not_found: 'No se encontró la cuenta seleccionada.',
            };
            const error = new Error(messages[result.error] || 'No se pudo completar el cambio de contraseña.');
            error.code = result.error;
            throw error;
        }
        return result;
    }

    document.querySelectorAll('[data-password-change]').forEach((button) => {
        button.addEventListener('click', () => {
            requestUrl = button.dataset.passwordChangeUrl;
            document.getElementById('passwordChangeTarget').textContent =
                button.dataset.passwordChangeTarget ? `Cuenta: ${button.dataset.passwordChangeTarget}` : '';
            requestForm.reset();
            verifyForm.reset();
            requestForm.hidden = false;
            verifyForm.hidden = true;
            feedback.hidden = true;
            requestButton.disabled = false;
            verifyButton.disabled = false;
            modal.show();
        });
    });

    requestForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        requestButton.disabled = true;
        try {
            const response = await fetch(requestUrl, {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': csrfInput.value,
                },
                body: JSON.stringify({
                    new_password: requestForm.elements.new_password.value,
                    confirm_password: requestForm.elements.confirm_password.value,
                }),
            });
            const result = await readJson(response);
            requestForm.reset();
            document.getElementById('passwordChangeEmail').textContent = result.maskedEmail;
            expiresAt = new Date(result.expiresAt).getTime();
            requestForm.hidden = true;
            verifyForm.hidden = false;
            document.getElementById('passwordChangeOtp').focus();
            updateCountdown();
            countdownTimer = window.setInterval(updateCountdown, 1000);
        } catch (error) {
            showFeedback(error.message, true);
            requestButton.disabled = false;
        }
    });

    verifyForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (Date.now() >= expiresAt) {
            updateCountdown();
            return;
        }
        verifyButton.disabled = true;
        try {
            const response = await fetch('/account/password-change/verify', {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': csrfInput.value,
                },
                body: JSON.stringify({ otp: verifyForm.elements.otp.value }),
            });
            const result = await readJson(response);
            window.clearInterval(countdownTimer);
            showFeedback('La contraseña se cambió correctamente.');
            verifyForm.hidden = true;
            if (result.mustReauthenticate) {
                window.setTimeout(() => window.location.assign('/login'), 1500);
            } else {
                window.setTimeout(() => modal.hide(), 1500);
            }
        } catch (error) {
            showFeedback(error.message, true);
            verifyButton.disabled = ['otp_expired', 'otp_locked', 'challenge_missing'].includes(error.code);
        }
    });

    modalElement.addEventListener('hidden.bs.modal', () => {
        window.clearInterval(countdownTimer);
    });
})();
</script>
