<nav class="navbar navbar-expand-lg bg-white border-bottom shadow-sm">
    <div class="container-fluid px-lg-4">
        <a class="navbar-brand fw-bold text-primary" href="/dashboard">SIGEMED</a>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <a class="btn btn-sm btn-outline-dark" href="/dashboard">Menú principal</a>
            <a class="btn btn-sm btn-outline-primary" href="/agenda">Agenda</a>
            <a class="btn btn-sm btn-outline-primary" href="/pacientes">Pacientes</a>
            <% if (currentUser && currentUser.roles.some((role) => ['system_admin', 'audit_security', 'admissions', 'doctor', 'nurse'].includes(role))) { %>
                <a class="btn btn-sm btn-outline-primary" href="/reports">Reportes</a>
            <% } %>
            <% if (currentUser && currentUser.roles.includes('admissions')) { %>
                <a class="btn btn-sm btn-outline-success" href="/billing">Caja</a>
            <% } %>
            <% if (currentUser && currentUser.roles.includes('system_admin')) { %>
                <a class="btn btn-sm btn-outline-secondary" href="/admin/billing">Configurar facturación</a>
            <% } %>
            <% if (currentUser && currentUser.roles.some((role) => ['system_admin', 'audit_security'].includes(role))) { %>
                <a class="btn btn-sm btn-outline-secondary" href="/admin/users">Usuarios</a>
                <a class="btn btn-sm btn-outline-secondary" href="/admin/doctors">Médicos</a>
            <% } %>
            <span class="small text-muted d-none d-md-inline"><%= currentUser ? currentUser.name : '' %></span>
            <form action="/logout" method="POST" class="m-0">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-sm btn-outline-danger" type="submit">Salir</button>
            </form>
        </div>
    </div>
</nav>
<script>
(() => {
    const refreshEveryMs = 5 * 60 * 1000;
    const idleAfterMs = 10 * 60 * 1000;
    let lastActivityAt = Date.now();
    let lastRefreshAt = 0;
    let refreshing = false;

    async function refreshSession() {
        if (refreshing) return;
        refreshing = true;
        lastRefreshAt = Date.now();
        try {
            const response = await fetch('/auth/session/heartbeat', {
                credentials: 'same-origin',
                cache: 'no-store',
            });
            const contentType = response.headers.get('content-type') || '';
            if (!response.ok || !contentType.includes('application/json')) {
                window.location.assign('/login?error=session');
                return;
            }
            const { csrfToken } = await response.json();
            document.querySelectorAll('input[name="_csrf"]').forEach((input) => {
                input.value = csrfToken;
            });
        } catch (error) {
            console.error('No se pudo renovar la sesión de SIGEMED:', error);
        } finally {
            refreshing = false;
        }
    }

    function markActivity() {
        lastActivityAt = Date.now();
        if (lastActivityAt - lastRefreshAt >= refreshEveryMs) {
            void refreshSession();
        }
    }

    ['pointerdown', 'keydown', 'input', 'touchstart'].forEach((eventName) => {
        document.addEventListener(eventName, markActivity, { passive: true });
    });
    window.setInterval(() => {
        const now = Date.now();
        if (now - lastActivityAt < idleAfterMs && now - lastRefreshAt >= refreshEveryMs) {
            void refreshSession();
        }
    }, 60 * 1000);
})();
</script>
