<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EMR - Directorio de Pacientes</title>
    <!-- Importar Bootstrap 5 CSS -->
    <link href="/assets/bootstrap/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<%- include('partials/navigation') %>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary fw-bold">Directorio de Pacientes</h2>
            <p class="text-muted mb-0">Gestión centralizada de pacientes - Atención Primaria (APS)</p>
        </div>
        <% if (currentUser.roles.includes('admissions') || currentUser.roles.includes('system_admin')) { %>
            <button class="btn btn-success shadow-sm" data-bs-toggle="modal" data-bs-target="#modalNuevoPaciente">
                + Nuevo Paciente
            </button>
        <% } %>
    </div>
    <% if (message) { %><div class="alert alert-success" role="status"><%= message %></div><% } %>
    <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form action="/pacientes" method="GET" role="search" aria-label="Buscar pacientes">
                <label for="patientDirectorySearch" class="form-label fw-bold">Buscar paciente</label>
                <div class="input-group">
                    <input
                        id="patientDirectorySearch"
                        name="search"
                        type="search"
                        class="form-control"
                        value="<%= search %>"
                        maxlength="80"
                        placeholder="Cédula, HMC, nombre o apellido (mínimo 3 caracteres)"
                        aria-describedby="patientSearchHelp">
                    <button class="btn btn-primary" type="submit">Buscar</button>
                    <% if (search) { %>
                        <a class="btn btn-outline-secondary" href="/pacientes">Limpiar</a>
                    <% } %>
                </div>
                <div id="patientSearchHelp" class="form-text">
                    Busca por documento, número de historia clínica, nombre o apellido.
                    Escribe al menos 3 caracteres.
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de Pacientes -->
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Documento</th>
                            <th>Nombre Completo</th>
                            <th>Género</th>
                            <th>Fecha Nacimiento</th>
                            <th>Teléfono</th>
                            <th>Email</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (pacientes.length > 0) { %>
                            <% pacientes.forEach(paciente => { %>
                                <tr>
                                    <td><%= paciente.id %></td>
                                    <td><code><%= paciente.dni_document %></code></td>
                                    <td class="fw-bold text-dark"><%= paciente.first_name %> <%= paciente.last_name %></td>
                                    <td>
                                        <span class="badge bg-secondary"><%= paciente.gender || 'N/D' %></span>
                                    </td>
                                    <td><%= paciente.birth_date ? new Date(paciente.birth_date).toISOString().split('T')[0] : 'N/D' %></td>
                                    <td><%= paciente.phone || 'N/A' %></td>
                                    <td><%= paciente.email || 'No registrado' %></td>
                                    <td class="text-center">
                                        <% if (currentUser.roles.includes('doctor') || currentUser.roles.includes('system_admin')) { %>
                                            <a href="/patients/<%= paciente.id %>/history" class="btn btn-sm btn-outline-primary mb-1 fw-bold shadow-sm">
                                                Ver <%= paciente.medical_record_number || 'Historia' %>
                                            </a>
                                        <% } %>
                                        
                                        <% if (currentUser.roles.includes('admissions') || currentUser.roles.includes('system_admin')) { %>
                                            <button
                                                class="btn btn-sm btn-outline-warning mb-1 shadow-sm"
                                                type="button"
                                                data-edit-patient
                                                data-patient-id="<%= paciente.id %>"
                                                data-patient-document="<%= paciente.dni_document || '' %>"
                                                data-patient-document-type="<%= paciente.document_type %>"
                                                data-patient-first-name="<%= paciente.first_name %>"
                                                data-patient-last-name="<%= paciente.last_name %>"
                                                data-patient-birth-date="<%= paciente.birth_date ? new Date(paciente.birth_date).toISOString().split('T')[0] : '' %>"
                                                data-patient-gender="<%= paciente.gender || '' %>"
                                                data-patient-phone="<%= paciente.phone || '' %>"
                                                data-patient-email="<%= paciente.email || '' %>"
                                                aria-label="Editar paciente <%= paciente.first_name %> <%= paciente.last_name %>">
                                                Editar
                                            </button>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    <%= search ? 'No se encontraron pacientes para esa búsqueda.' : 'No hay pacientes registrados aún en la base de datos.' %>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
        <% if (hasPreviousPage || hasNextPage) { %>
            <nav class="d-flex justify-content-between align-items-center my-3" aria-label="Paginación del directorio">
                <% if (hasPreviousPage) { %>
                    <a class="btn btn-outline-primary"
                       href="/pacientes?search=<%= encodeURIComponent(search) %>&amp;page=<%= page - 1 %>">Anterior</a>
                <% } else { %>
                    <span></span>
                <% } %>
                <span class="text-muted">Página <%= page %></span>
                <% if (hasNextPage) { %>
                    <a class="btn btn-outline-primary"
                       href="/pacientes?search=<%= encodeURIComponent(search) %>&amp;page=<%= page + 1 %>">Siguiente</a>
                <% } %>
            </nav>
        <% } %>
    </div>
</div>

<% if (currentUser.roles.includes('admissions') || currentUser.roles.includes('system_admin')) { %>
<!-- VENTANA MODAL: Formulario de Nuevo Paciente -->
<div class="modal fade" id="modalNuevoPaciente" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form action="/patients/create" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="modalLabel">Registrar Nuevo Paciente</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Documento de Identidad (DNI):</label>
                            <input type="text" class="form-control" name="dni_document" required placeholder="Ej: V-12345678">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Género:</label>
                            <select class="form-select" name="gender">
                                <option value="Masculino">Masculino</option>
                                <option value="Femenino">Femenino</option>
                                <option value="Otro">Otro</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Nombres:</label>
                            <input type="text" class="form-control" name="first_name" required placeholder="Ej: Juan Carlos">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Apellidos:</label>
                            <input type="text" class="form-control" name="last_name" required placeholder="Ej: Pérez Gómez">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Fecha de Nacimiento:</label>
                            <input type="date" class="form-control" name="birth_date" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Teléfono de Contacto:</label>
                            <input type="text" class="form-control" name="phone" placeholder="Ej: 0414-1234567">
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Correo Electrónico:</label>
                            <input type="email" class="form-control" name="email" placeholder="Ej: correo@dominio.com" 
                                   pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$" 
                                   title="Ingrese un correo electrónico válido, por ejemplo: usuario@dominio.com">
                            <div class="form-text">Formato requerido: usuario@dominio.com</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">Guardar Paciente</button>
                </div>
            </form>
        </div>
    </div>
</div>
<% } %>

<!-- VENTANA MODAL: Formulario de Editar Paciente -->
<% if (currentUser.roles.includes('admissions') || currentUser.roles.includes('system_admin')) { %>
<div class="modal fade" id="modalEditarPaciente" tabindex="-1" aria-labelledby="modalEditarLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="formEditarPaciente" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold" id="modalEditarLabel">Modificar Datos del Paciente</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Documento de Identidad (DNI):</label>
                            <input type="text" class="form-control" id="edit_dni" name="dni_document">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Género:</label>
                            <select class="form-select" id="edit_gender" name="gender">
                                <option value="">No especificado</option>
                                <option value="Masculino">Masculino</option>
                                <option value="Femenino">Femenino</option>
                                <option value="Otro">Otro</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Nombres:</label>
                            <input type="text" class="form-control" id="edit_first_name" name="first_name" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Apellidos:</label>
                            <input type="text" class="form-control" id="edit_last_name" name="last_name" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Fecha de Nacimiento:</label>
                            <input type="date" class="form-control" id="edit_birth_date" name="birth_date">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Teléfono de Contacto:</label>
                            <input type="text" class="form-control" id="edit_phone" name="phone">
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Correo Electrónico:</label>
                            <input type="email" class="form-control" id="edit_email" name="email"
                                   pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$" 
                                   title="Ingrese un correo electrónico válido, por ejemplo: usuario@dominio.com">
                            <div class="form-text">Formato requerido: usuario@dominio.com</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning fw-bold">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>
<% } %>

<!-- Importar Bootstrap 5 JS Bundle y Script de Edición -->
<script src="/assets/bootstrap/js/bootstrap.bundle.min.js"></script>
<script>
    const editPatientForm = document.getElementById('formEditarPaciente');
    if (editPatientForm) {
        document.querySelectorAll('[data-edit-patient]').forEach((button) => {
            button.addEventListener('click', () => {
                editPatientForm.action = `/patients/update/${encodeURIComponent(button.dataset.patientId)}`;
                editPatientForm.elements.dni_document.value = button.dataset.patientDocument;
                editPatientForm.elements.dni_document.required = button.dataset.patientDocumentType !== 'none';
                editPatientForm.elements.first_name.value = button.dataset.patientFirstName;
                editPatientForm.elements.last_name.value = button.dataset.patientLastName;
                editPatientForm.elements.birth_date.value = button.dataset.patientBirthDate;
                editPatientForm.elements.gender.value = button.dataset.patientGender;
                editPatientForm.elements.phone.value = button.dataset.patientPhone;
                editPatientForm.elements.email.value = button.dataset.patientEmail;
                bootstrap.Modal.getOrCreateInstance(document.getElementById('modalEditarPaciente')).show();
            });
        });
    }
</script>
</body>
</html>