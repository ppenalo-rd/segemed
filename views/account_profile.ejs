<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Mi perfil | SIGEMED</title>
    <link href="/assets/bootstrap/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<%- include('partials/navigation') %>
<main class="container py-4">
    <div class="mb-4">
        <p class="text-primary fw-semibold mb-1">Configuración de cuenta</p>
        <h1 class="h3">Mi perfil</h1>
    </div>
    <section class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <dl class="row mb-4">
                <dt class="col-sm-3">Nombre</dt>
                <dd class="col-sm-9"><%= account.name %></dd>
                <dt class="col-sm-3">Correo registrado</dt>
                <dd class="col-sm-9"><%= account.email %></dd>
            </dl>
            <button
                class="btn btn-outline-primary"
                type="button"
                data-password-change
                data-password-change-url="/account/password-change/request">
                Cambiar contraseña
            </button>
        </div>
    </section>
</main>
<script src="/assets/bootstrap/js/bootstrap.bundle.min.js"></script>
<%- include('partials/password-change-modal') %>
</body>
</html>
