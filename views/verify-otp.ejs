<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Verificación de acceso | SIGEMED</title>
    <link href="/assets/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: radial-gradient(circle at top left, #dbeafe, transparent 42%),
                        linear-gradient(135deg, #eef5ff, #e6f6f1);
        }
        .otp-card {
            max-width: 470px;
            border: 1px solid rgba(255, 255, 255, .8);
            background: rgba(255, 255, 255, .82);
            box-shadow: 0 1.25rem 3.5rem rgba(23, 65, 110, .15);
            backdrop-filter: blur(16px);
        }
        .otp-input {
            letter-spacing: .65rem;
            font-size: 1.7rem;
            font-weight: 700;
            text-align: center;
        }
    </style>
</head>
<body>
<main class="container min-vh-100 d-flex align-items-center justify-content-center py-4">
    <section class="card otp-card rounded-4 w-100">
        <div class="card-body p-4 p-md-5">
            <p class="text-primary fw-semibold mb-1">SIGEMED · Verificación segura</p>
            <h1 class="h3 mb-2">Confirma tu identidad</h1>
            <p class="text-secondary mb-4">Enviamos un código de 6 dígitos a <strong><%= maskedEmail %></strong>. No compartas este código.</p>
            <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
            <% if (message) { %><div class="alert alert-success" role="status"><%= message %></div><% } %>
            <form action="/auth/verify-otp" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="mb-3">
                    <label class="form-label fw-semibold" for="otp">Código de verificación</label>
                    <input class="form-control form-control-lg otp-input" id="otp" name="otp" type="text"
                           inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6"
                           maxlength="6" aria-describedby="otpHelp" required autofocus>
                    <div id="otpHelp" class="form-text">El código vence en <span id="otpCountdown" data-expires-at="<%= expiresAt %>">05:00</span>.</div>
                </div>
                <button class="btn btn-primary btn-lg w-100 mb-3" type="submit">Verificar y continuar</button>
            </form>
            <form action="/auth/resend-otp" method="POST" class="mb-3">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button id="resendOtpButton" class="btn btn-outline-success w-100" type="submit" data-resend-after="<%= resendAfter %>">
                    Reenviar código
                </button>
                <div id="resendOtpHelp" class="form-text text-center mt-1" aria-live="polite"></div>
            </form>
            <form action="/auth/cancel-otp" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-link text-secondary w-100" type="submit">Cancelar y volver al inicio de sesión</button>
            </form>
        </div>
    </section>
</main>
<script>
    const countdown = document.getElementById('otpCountdown');
    const resendButton = document.getElementById('resendOtpButton');
    const resendHelp = document.getElementById('resendOtpHelp');
    const expiresAt = new Date(countdown.dataset.expiresAt).getTime();
    const resendAfter = new Date(resendButton.dataset.resendAfter).getTime();

    function updateTimers() {
        const now = Date.now();
        const secondsLeft = Math.max(0, Math.ceil((expiresAt - now) / 1000));
        countdown.textContent = `${String(Math.floor(secondsLeft / 60)).padStart(2, '0')}:${String(secondsLeft % 60).padStart(2, '0')}`;
        const resendSeconds = Math.max(0, Math.ceil((resendAfter - now) / 1000));
        resendButton.disabled = resendSeconds > 0;
        resendHelp.textContent = resendSeconds ? `Podrás solicitar otro código en ${resendSeconds} segundos.` : '';
    }

    updateTimers();
    window.setInterval(updateTimers, 1000);
</script>
</body>
</html>
